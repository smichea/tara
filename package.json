{
  "name": "tara-language-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open, community-built language learning app. Filipino first.",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "python3 -m http.server 4173 --directory dist --bind 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-courses.mjs",
    "check": "npm run validate && npm test && npm run test:audio && npm run test:translation",
    "test:translation": "node tests/translation-model.mjs",
    "test:audio": "python3 -m unittest discover -s tests -p audio_pipeline_test.py"
  },
  "engines": {
    "node": ">=20"
  }
}
